# FE-16: point the dev server at the real backend instead of a relative
# /api path (e.g. `cd backend && uvicorn app.main:create_app --factory`).
# Copy to .env.local and adjust the port to match. Component tests always
# use the FE-02 mock server regardless of this value.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
